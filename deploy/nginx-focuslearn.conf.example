# Nginx 反向代理 Gunicorn（Django）示例
# ------------------------------------------------------------
# 部署注意：
#   1) 同一 listen + server_name 只能有一个 server 块处理，否则会出现
#      conflicting server name ... ignored
#   2) 已上 HTTPS 时：80 端口只做 301 跳转，不要再对同一域名 proxy_pass
#   3) 证书未就绪、仅用公网 IP 调试时：可暂时只保留「仅 HTTP」那一段，注释掉 443 与 301
# ------------------------------------------------------------

upstream django_focuslearn {
    # 二选一：与 Gunicorn 的 --bind 一致
    server unix:/run/gunicorn/focuslearn.sock fail_timeout=0;
    # server 127.0.0.1:8000 fail_timeout=0;
}

# ========== 正式：HTTP 整站跳 HTTPS（不要与下面 443 以外的 80 反代重复 linzz.cn）==========
server {
    listen 80;
    listen [::]:80;
    server_name linzz.cn www.linzz.cn;

    return 301 https://$host$request_uri;
}

# ========== 正式：HTTPS 反代 Django ==========
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name linzz.cn www.linzz.cn;

    ssl_certificate     /etc/nginx/ssl/linzz.cn/www.linzz.cn.pem;
    ssl_certificate_key /etc/nginx/ssl/linzz.cn/www.linzz.cn.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 100M;

    location /static/ {
        alias /var/www/linzz/focuslearn/staticfiles/;
        access_log off;
        expires 30d;
    }

    location /media/ {
        alias /var/www/linzz/focuslearn/media/;
        access_log off;
        expires 7d;
    }

    location / {
        proxy_pass http://django_focuslearn;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# ========== 可选：证书未就绪时，仅用 IP 走 HTTP 调试（server_name 不要写 linzz.cn）==========
